{
  "name": "Fleet Example Policy",
  "description": "Example fleet password policy for API documentation",
  "complexityConstraints": {
    "minLength": 15,
    "minLowercase": 1,
    "minUppercase": 1,
    "minNumeric": 1,
    "minSpecial": 1,
    "passwordHistory": 3
  },
  "expirationConstraints": {
    "maxDays": 365,
    "warnDays": 7
  },
  "lockoutConstraints": {
    "lockoutMaxAuthFailures": 3,
    "lockoutEvaluationPeriod": 900,
    "lockoutPeriod": 900
  }
}
